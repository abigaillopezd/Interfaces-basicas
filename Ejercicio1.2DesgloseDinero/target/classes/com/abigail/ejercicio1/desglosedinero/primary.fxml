<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.abigail.ejercicio1.desglosedinero.PrimaryController"
      alignment="CENTER"
      spacing="25">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Dinero:"/>

        <TextField fx:id="txtDinero"
                   text="9999"
                   alignment="CENTER_RIGHT"
                   prefWidth="180"
                   prefHeight="32"/>

        <Button text="X"
                onAction="#limpiar"
                prefWidth="40"
                prefHeight="32"/>

        <Button text="Desglosar"
                onAction="#desglosar"
                prefWidth="110"
                prefHeight="32"/>
    </HBox>

    <HBox alignment="CENTER"
          spacing="20">

        <VBox alignment="CENTER_RIGHT"
              spacing="10"
              prefWidth="250"
              minWidth="250"
              prefHeight="300"
              style="-fx-border-color: black; -fx-border-width: 1; -fx-padding: 15;">

            <Label text="Billetes de $500" maxWidth="Infinity"/>
            <Label text="Billetes de $200" maxWidth="Infinity"/>
            <Label text="Billetes de $100" maxWidth="Infinity"/>
            <Label text="Billetes de $50" maxWidth="Infinity"/>
            <Label text="Billetes de $20" maxWidth="Infinity"/>
            <Label text="Monedas de $10" maxWidth="Infinity"/>
            <Label text="Monedas de $5" maxWidth="Infinity"/>
            <Label text="Monedas de $2" maxWidth="Infinity"/>
            <Label text="Monedas de $1" maxWidth="Infinity"/>

        </VBox>

        <VBox alignment="CENTER_LEFT"
              spacing="10"
              prefWidth="250"
              minWidth="250"
              prefHeight="300"
              style="-fx-border-color: black; -fx-border-width: 1; -fx-padding: 15;">

            <Label fx:id="lbl500" text="19"/>
            <Label fx:id="lbl200" text="2"/>
            <Label fx:id="lbl100" text="0"/>
            <Label fx:id="lbl50" text="1"/>
            <Label fx:id="lbl20" text="2"/>
            <Label fx:id="lbl10" text="0"/>
            <Label fx:id="lbl5" text="1"/>
            <Label fx:id="lbl2" text="2"/>
            <Label fx:id="lbl1" text="0"/>

        </VBox>

    </HBox>

</VBox>
