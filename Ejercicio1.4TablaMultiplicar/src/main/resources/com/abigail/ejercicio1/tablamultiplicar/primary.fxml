<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="280.0" spacing="18" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abigail.ejercicio1.tablamultiplicar.PrimaryController">

       <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Ejemplo" />

    <HBox alignment="CENTER_LEFT" spacing="40">

        <VBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Tabla del:" />
            <TextField fx:id="txtNumero" alignment="CENTER_RIGHT" prefWidth="50" text="5" />
        </VBox>

        <VBox alignment="CENTER" spacing="10">
            <Button onAction="#calcular" prefWidth="100" text="Calcular" textAlignment="RIGHT">
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
         </Button>
            <Button onAction="#limpiar" prefWidth="100" text="Limpiar" />
        </VBox>

    </HBox>

    <TextArea fx:id="txtResultados" editable="false" prefHeight="230" prefWidth="450.0" wrapText="false" VBox.vgrow="ALWAYS" />
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>

</VBox>
