<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.abigail.ejercicio1.controlgastossemanales.PrimaryController"
      spacing="45"
      alignment="CENTER"
      prefWidth="650"
      prefHeight="350">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <VBox spacing="15" prefWidth="300">

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Alimentación" prefWidth="110"/>
            <TextField fx:id="txtAlimentacion"
                       text="800"
                       prefWidth="120"
                       alignment="CENTER_RIGHT"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Refrigerios" prefWidth="110"/>
            <TextField fx:id="txtRefrigerios"
                       text="300"
                       prefWidth="120"
                       alignment="CENTER_RIGHT"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Transporte" prefWidth="110"/>
            <TextField fx:id="txtTransporte"
                       text="600"
                       prefWidth="120"
                       alignment="CENTER_RIGHT"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Telefonía" prefWidth="110"/>
            <TextField fx:id="txtTelefonia"
                       text="50"
                       prefWidth="120"
                       alignment="CENTER_RIGHT"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Otros" prefWidth="110"/>
            <TextField fx:id="txtOtros"
                       text="33"
                       prefWidth="120"
                       alignment="CENTER_RIGHT"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Calcular estadísticas"
                    onAction="#calcular"
                    prefWidth="165"/>
            <Button text="Limpiar"
                    onAction="#limpiar"
                    prefWidth="85"/>
        </HBox>

    </VBox>

    <VBox spacing="18" prefWidth="220">

        <Label text="Estadísticas"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <Label text="Total semanal"/>
        <TextField fx:id="txtTotal"
                   text="1783"
                   editable="false"
                   prefWidth="200"
                   alignment="CENTER_LEFT"/>

        <Label text="Gasto más alto"/>
        <TextField fx:id="txtGastoAlto"
                   text="Alimentación"
                   editable="false"
                   prefWidth="200"
                   alignment="CENTER_LEFT"/>

    </VBox>

</HBox>
